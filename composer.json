{
  "name": "wachiravit-thitagran/wp-mcp-oauth",
  "description": "OAuth 2.1 authorization layer for WordPress MCP endpoints.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "find . -type f -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs -n --standard=phpcs.xml.dist wp-mcp-oauth.php includes"
  }
}
